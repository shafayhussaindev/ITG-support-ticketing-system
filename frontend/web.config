<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the built front end.

  Place this in the same folder as index.html after `npm run build` — that is,
  copy it into `dist/` alongside the published output, or set the IIS site's
  physical path to a folder containing both.

  It exists because the security headers this application relies on are set by
  the web server, not by the application. `frontend/nginx.conf` sets them for
  nginx; IIS reads nothing from that file, so serving the built output from IIS
  without this loses every one of them silently.

  Requires the URL Rewrite module: https://www.iis.net/downloads/microsoft/url-rewrite
-->
<configuration>
  <system.webServer>

    <!--
      Single-page application routing.

      React Router handles /tickets/123 in the browser, but a refresh on that
      address asks IIS for a file that does not exist. Without this rule the user
      gets a 404 from IIS on every page except the home page — the single most
      common IIS mistake with a React application.

      Real files and folders are served normally; everything else is handed to
      index.html so the application can route it. /api and /hubs are excluded so
      they can reach the reverse proxy rather than being swallowed here.
    -->
    <rewrite>
      <rules>
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/(api|hubs|health)/" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <!--
          IIS advertises itself and its ASP.NET version by default. Neither tells a
          legitimate visitor anything; both tell somebody scanning for known
          vulnerabilities exactly what to try.
        -->
        <remove name="X-Powered-By" />

        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="no-referrer" />
        <add name="Cross-Origin-Opener-Policy" value="same-origin" />
        <add name="X-Permitted-Cross-Domain-Policies" value="none" />

        <!--
          The policy that matters most. `script-src 'self'` with no 'unsafe-inline'
          and no 'unsafe-eval' means an injected script has no way to execute, which
          is why the theme initialiser lives in its own file rather than an inline
          <script> tag. Do not add 'unsafe-inline' here to make something work —
          move the code into a file instead.

          'unsafe-inline' is present for styles only, which the bundler requires and
          which cannot be used to execute code.
        -->
        <add name="Content-Security-Policy"
             value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" />

        <!--
          Enable once HTTPS is confirmed working and you are certain every subdomain
          can serve it. A browser that has seen this header refuses plain HTTP for
          two years and there is no way to retract it early.
        -->
        <!-- <add name="Strict-Transport-Security" value="max-age=63072000; includeSubDomains" /> -->
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <!--
        IIS refuses to serve extensions it does not recognise. Without these, fonts
        and source maps return 404 and the failure looks like a build problem.
      -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".map" />
      <mimeMap fileExtension=".map" mimeType="application/json" />

      <!--
        A conservative default. The per-folder rules below override it: files under
        /assets carry a content hash in their name, so they can be cached for a year
        and a new build simply produces new names.
      -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

    <httpCompression>
      <dynamicTypes>
        <add mimeType="application/json" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
      </dynamicTypes>
      <staticTypes>
        <add mimeType="text/css" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="font/woff2" enabled="true" />
      </staticTypes>
    </httpCompression>

  </system.webServer>

  <!--
    Hashed asset filenames never change contents, so a year is safe and saves the
    browser asking. index.html must never be cached, or a user keeps loading last
    week's application after you deploy.
  -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00"
                     cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, must-revalidate" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

</configuration>

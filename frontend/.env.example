# Copy to .env.local. Only VITE_-prefixed variables reach the browser bundle.
#
# Never put a secret here. Everything in this file is publicly readable in the
# shipped JavaScript — the OpenAI key in particular stays on the backend only.

VITE_API_BASE_URL=http://localhost:5180/api/v1
VITE_SIGNALR_URL=http://localhost:5180/hubs

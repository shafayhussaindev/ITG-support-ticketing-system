# Copy to .env beside docker-compose.yml. That file is gitignored — never commit
# real values. Compose refuses to start when a required value is missing rather
# than falling back to a default somebody would forget to change.

# SQL Server's sa password. Must satisfy its complexity rules: at least eight
# characters from three of upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=

# At least 32 characters. Generate with: openssl rand -base64 48
# Changing it invalidates every issued access token immediately.
JWT_SIGNING_KEY=

# First run only. Creates the organization and one Super Admin, and prints a
# one-time password to the API's log. Ignored once an organization exists.
BOOTSTRAP_ORG_NAME=Your Company Limited
BOOTSTRAP_ORG_CODE=YCL
BOOTSTRAP_TIMEZONE=Asia/Karachi
BOOTSTRAP_ADMIN_EMAIL=

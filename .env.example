# Copy to .env for container or CI use. .env is gitignored — never commit real values.
# Locally, prefer `dotnet user-secrets` over a file on disk.
#
# Double underscore maps to configuration nesting: Jwt__SigningKey => Jwt:SigningKey.
# Environment variables take precedence over appsettings files AND user-secrets.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5180

# ---- Database --------------------------------------------------------------
ConnectionStrings__SupportTicketingDb=Server=.;Database=SupportTicketing;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true

# ---- JWT -------------------------------------------------------------------
# Minimum 32 characters. Generate with:
#   openssl rand -base64 48
# Rotating this value invalidates every issued access token immediately.
Jwt__SigningKey=
Jwt__Issuer=SupportTicketing.Api
Jwt__Audience=SupportTicketing.Spa
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

# ---- Authentication policy --------------------------------------------------
Auth__MaxFailedAccessAttempts=5
Auth__LockoutMinutes=15
Auth__MinimumPasswordLength=12
Auth__MaxActiveSessions=5
Auth__RefreshTokenDays=7

# ---- Rate limiting ----------------------------------------------------------
# The sign-in budget is per client address; the global budget is per user.
RateLimiting__Auth__PermitLimit=10
RateLimiting__Auth__WindowSeconds=60
RateLimiting__Global__PermitLimit=300
RateLimiting__Global__WindowSeconds=60

# ---- CORS -------------------------------------------------------------------
# An explicit allowlist. Credentials are sent with these requests, so a wildcard
# is neither permitted nor safe.
Cors__AllowedOrigins__0=http://localhost:5173

# ---- Demo seeding -----------------------------------------------------------
# Both of these AND ASPNETCORE_ENVIRONMENT=Development are required before the
# seeder writes anything. Leave EnableDemoAccounts false outside local development.
# If DemoPassword is blank the seeder generates a random one and logs it once.
Seed__EnableDemoAccounts=false
Seed__DemoPassword=

# ---- Reverse proxy ----------------------------------------------------------
# Required under IIS, nginx or any load balancer. Without it the audit log records
# the proxy's address rather than the person's, and the sign-in rate limiter treats
# every user in the organization as one client.
#
# Leave both unset when Kestrel is exposed directly: X-Forwarded-For is a request
# header like any other, and accepting it from an arbitrary caller lets that caller
# choose what the audit log says about them.
# ForwardedHeaders__KnownProxies__0=10.0.0.4
# ForwardedHeaders__KnownNetworks__0=10.0.0.0/24
# ForwardedHeaders__ForwardLimit=1

# ---- First-run bootstrap ----------------------------------------------------
# Creates the organization and the first administrator on a database that has no
# organization yet, and prints a one-time password once. Ignored on every start
# after that, so these can be left in place.
#
# Without them a freshly migrated database has no roles, no permissions and no
# account, and nobody can sign in.
Bootstrap__Organization__Name=
Bootstrap__Organization__Code=
Bootstrap__Organization__TicketPrefix=TKT
Bootstrap__Organization__TimeZone=UTC
Bootstrap__Administrator__Email=
Bootstrap__Administrator__FirstName=System
Bootstrap__Administrator__LastName=Administrator

# ---- AI assistance (optional) -----------------------------------------------
# Read by the backend only; this key must never reach the browser. Without it the
# system runs identically and reports AI unavailable, and every capability stays
# off until an administrator enables it at Administration -> AI assistance.
# OpenAi__ApiKey=
# OpenAi__Model=gpt-4o-mini
# OpenAi__TimeoutSeconds=20
